{
  "project": {
    "title": "Asteroid Data Engineering Project",
    "version": "1.0",
    "author": "data-platform-modernization-consulting",
    "cloud_provider": "AWS",
    "region": "us-east-1",
    "estimated_cost": "$0.00 MXN / Free Tier"
  },
  "architecture_layers": [
    {
      "name": "Ingesta Serverless",
      "components": [
        {
          "id": "cron_nasa",
          "name": "EventBridge Cron",
          "service": "aws_cloudwatch_event_rule",
          "description": "Trigger diario (00:00 UTC)"
        },
        {
          "id": "lambda_nasa_ext",
          "name": "Lambda Extracción NASA",
          "service": "aws_lambda_function",
          "description": "Consume API NeoWS de NASA"
        }
      ]
    },
    {
      "name": "Data Lake (Medallion)",
      "components": [
        {
          "id": "s3_bronze",
          "name": "S3 Bronze",
          "service": "aws_s3_bucket",
          "description": "Payload JSON crudo de objetos cercanos a la tierra"
        },
        {
          "id": "s3_silver",
          "name": "S3 Silver",
          "service": "aws_s3_bucket",
          "description": "Parquet limpio, tipado y estandarizado"
        },
        {
          "id": "s3_gold",
          "name": "S3 Gold",
          "service": "aws_s3_bucket",
          "description": "Métricas de riesgo, peligro y probabilidad de impacto"
        }
      ]
    },
    {
      "name": "Procesamiento y Analítica",
      "components": [
        {
          "id": "lambda_clean_silver",
          "name": "Lambda Limpieza & Parquet",
          "service": "aws_lambda_function",
          "description": "Reemplaza Glue Job para conversión Bronze a Silver"
        },
        {
          "id": "lambda_metrics_gold",
          "name": "Lambda KPIs Riesgo",
          "service": "aws_lambda_function",
          "description": "Reemplaza Glue Job para modelado Silver a Gold"
        },
        {
          "id": "asteroid_db",
          "name": "Amazon Athena",
          "service": "aws_athena_database",
          "description": "Consultas SQL sobre datos refinados"
        }
      ]
    }
  ],
  "data_pipeline_flow": [
    { "step": 1, "from": "NASA NeoWS API (External)", "to": "lambda_nasa_ext", "action": "Petición HTTP vía Cron" },
    { "step": 2, "from": "lambda_nasa_ext", "to": "s3_bronze", "action": "Ingesta JSON crudo" },
    { "step": 3, "from": "s3_bronze", "to": "lambda_clean_silver", "action": "Trigger transformación" },
    { "step": 4, "from": "lambda_clean_silver", "to": "s3_silver", "action": "Escritura Parquet refinado" },
    { "step": 5, "from": "s3_silver", "to": "lambda_metrics_gold", "action": "Clasificación de riesgo" },
    { "step": 6, "from": "lambda_metrics_gold", "to": "s3_gold", "action": "Guardado de métricas" },
    { "step": 7, "from": "s3_silver / s3_gold", "to": "asteroid_db", "action": "Escaneo de datos" },
    { "step": 8, "from": "Cuerpo Técnico", "to": "asteroid_db", "action": "Consultas SQL" },
    { "step": 9, "from": "Dashboard (Tableau)", "to": "asteroid_db", "action": "Visualización de resultados" }
  ]
}